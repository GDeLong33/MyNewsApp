# Copy to server/.env and fill in. Never commit .env.

# Local development
PORT=3000
DATABASE_PATH=./data/mynews.db

# Bearer token for /admin endpoints (manual collect trigger, job log, article list).
# Use a long random value, e.g. `openssl rand -hex 32`. Leave empty to disable /admin.
ADMIN_TOKEN=replace-with-a-long-random-string

# Collect once at startup if the last run is more than 50 minutes old (true/false).
COLLECT_ON_STARTUP=true

# AI summaries (Google Gemini). Get a key at https://aistudio.google.com/apikey. Leave empty to disable AI;
# stories then show "AI analysis has not been generated" and everything else works.
GEMINI_API_KEY=
# Optional model override (default: gemini-3.5-flash-lite, free tier 500 requests/day, 15/minute).
GEMINI_MODEL=
# Free-tier budget. Model calls allowed per day (midnight-to-midnight Pacific, when Google resets the free quota;
# retries count), stories summarized per hourly run, minimum articles a story needs to get AI analysis, and the
# minimum milliseconds between calls.
AI_DAILY_BUDGET=250
AI_MAX_PER_RUN=20
AI_MIN_ARTICLES=2
AI_MIN_INTERVAL_MS=6500

# Production (Oracle VM): public hostname Caddy serves over HTTPS,
# e.g. 203-0-113-10.sslip.io for public IP 203.0.113.10, or your own domain.
# docker-compose.yml overrides PORT and DATABASE_PATH inside the container.
DOMAIN=your-ip-with-dashes.sslip.io
